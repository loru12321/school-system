{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "school-system",
  "main": "src/worker-dummy.js",
  "compatibility_date": "2026-06-27",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    // 当前数据模式：supabase | primary | hybrid
    // system_data 已迁移至 Cloudflare D1，生产读写以 D1 为主
    "CLOUD_SYSTEM_DATA_MODE": "primary"
    // 以下敏感配置请通过 Wrangler Secrets 管理，不要写入此文件：
    //   LEGACY_GATEWAY_ORIGIN   → npx wrangler secret put LEGACY_GATEWAY_ORIGIN
    //   SUPABASE_ORIGIN         → npx wrangler secret put SUPABASE_ORIGIN
    //   SUPABASE_REST_API_KEY   → npx wrangler secret put SUPABASE_REST_API_KEY
    //   APP_SESSION_SECRET      → npx wrangler secret put APP_SESSION_SECRET
    //   LEGACY_GATEWAY_API_KEY  → npx wrangler secret put LEGACY_GATEWAY_API_KEY
  },
  "routes": [
    {
      "pattern": "schoolsystem.com.cn/*",
      "zone_name": "schoolsystem.com.cn"
    },
    {
      "pattern": "www.schoolsystem.com.cn/*",
      "zone_name": "schoolsystem.com.cn"
    }
  ],
  "d1_databases": [
    {
      "binding": "GATEWAY_DATA_DB",
      "database_name": "school-system-gateway",
      "database_id": "0af7205c-eead-4c60-a792-b67f8198ac0b"
    },
    {
      "binding": "CLOUD_SYSTEM_DATA_DB",
      "database_name": "school-system-cloud-metadata",
      "database_id": "4ce32844-b42d-45ff-b436-818ffe714a08"
    }
  ]
}
