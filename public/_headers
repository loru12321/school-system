/*
  # Security Headers
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

  # Content Security Policy (CSP)
  # Note: unsafe-inline and unsafe-eval are temporary - see memory for migration roadmap
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; connect-src 'self' https://schoolsystem.com.cn https://www.schoolsystem.com.cn https://*.supabase.co https://timor.tech; worker-src 'self' blob:; manifest-src 'self'; report-uri /api/csp-report
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; connect-src 'self' https://schoolsystem.com.cn https://www.schoolsystem.com.cn https://*.supabase.co https://timor.tech; worker-src 'self' blob:; manifest-src 'self'; report-uri /api/csp-report

/
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/index.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/style-*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/boot-runtime-runtime-*.js
  ! Cache-Control
  ! CDN-Cache-Control
  ! Cloudflare-CDN-Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/assets/js/service-worker-runtime-runtime-*.js
  ! Cache-Control
  ! CDN-Cache-Control
  ! Cloudflare-CDN-Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/sw-runtime-*.js
  ! Cache-Control
  ! CDN-Cache-Control
  ! Cloudflare-CDN-Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/sw.js
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400

/icon.svg
  Cache-Control: public, max-age=86400
